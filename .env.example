# Copy this file to .env. Never commit real credentials.
# Neon: pooled URL for API, direct URL for migrations/backups. Local alternative below.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=
# For docker compose --profile local-db up: use postgresql://wellness:YOUR_LOCAL_PASSWORD@db:5432/wellness?sslmode=disable
LOCAL_POSTGRES_PASSWORD=replace-with-a-local-database-password
NODE_ENV=production
COOKIE_SECURE=true
PUBLIC_URL=https://your-domain.example
ADMIN_EMAIL=admin@your-domain.example
ADMIN_NAME=Wellness Administrator
ADMIN_PASSWORD=replace-with-a-long-unique-password
AUTH_SECRET=replace-with-at-least-32-random-characters

# Initial business details. Public contact details can also be published in the website editor.
BUSINESS_NAME=Wellness Home Care
BUSINESS_EMAIL=u.mary@ddin.rw
BUSINESS_PHONE=+250785706884
BUSINESS_WHATSAPP=
BUSINESS_ADDRESS=
BUSINESS_HOURS=
SERVICE_AREAS=Kigali
DOCUMENT_STORAGE_PATH=/app/private-documents
# Separate storage for administrator-approved public website photos and videos.
PUBLIC_MEDIA_STORAGE_PATH=/app/public-media

# Optional email. Without credentials, notifications remain in the in-app inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# Optional hosted checkout. Secret, webhook secret and PUBLIC_URL required; use test keys first.
# Public key reserved for future client checkout options.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Optional Twilio SMS and WhatsApp. Use approved senders and recipient consent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Optional approved WhatsApp template: {{1}} = recipient name, {{2}} = update message.
# Required for proactive WhatsApp messages outside the 24-hour service conversation.
TWILIO_WHATSAPP_CONTENT_SID=
