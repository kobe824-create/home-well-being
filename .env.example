# App connections: paste Neon's pooled string here (hostname contains -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Prisma migrations and backups need Neon's direct string (without -pooler).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional SMTP settings. Leave blank to keep requests in the admin dashboard only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=
